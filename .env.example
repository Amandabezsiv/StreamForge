DATABASE_URL=postgresql+psycopg://streamforge:streamforge@localhost:5432/streamforge
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_BYTES=1073741824
# 0 lets FFmpeg choose automatically. Use a positive integer to limit threads.
FFMPEG_THREADS=0
# A worker renews ownership every 10 seconds. The lease must be longer.
JOB_LEASE_SECONDS=30
JOB_LEASE_RENEWAL_SECONDS=10
